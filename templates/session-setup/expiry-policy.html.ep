%# ABOUTME: session-setup's expiry-policy screen: when a place in the sessions expires.
%# ABOUTME: An offer over sessions expires at the end of its session, as an occurrence's does; never is not offered.
% extends 'layouts/workflow';
% title 'When it expires';
% stash description => 'Say when what this offer buys stops being usable.';

% if (my @errors = @{ stash('errors') // [] }) {
<div class="alert alert-error" role="alert">
  <ul>
  % for my $error (@errors) {
    <li><%= ref $error ? $error->{message} : $error %></li>
  % }
  </ul>
</div>
% }

<form method="POST" action="<%= $action %>">
  <fieldset>
    <legend>Expiry policy</legend>
    <div>
      <input type="radio" id="expiry-end_of_occurrence" name="expiry" value="end_of_occurrence" required checked>
      <label for="expiry-end_of_occurrence">At the end of the session</label>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Continue</button>
  </div>
</form>
