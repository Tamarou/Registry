%# ABOUTME: session-setup's change-policy step, as offer-publishing asks it, for the offers over a program's sessions.
%# ABOUTME: A window moves a held booking up to and including its boundary, to its targets; it says how a price difference is paid and who approves.
% extends 'layouts/workflow';
% title 'Changes';
% stash description => 'Say whether a booking may move to another occurrence.';
% my $policy = stash('change_policy') // {};
% my $chosen = $policy->{kind} // '';
% my $targets = ref $policy->{targets} ? 'offer_ids' : $policy->{targets} // 'same_offer';
% my %listed = map { $_ => 1 } ref $policy->{targets} ? $policy->{targets}{offer_ids}->@* : ();
% my $difference = $policy->{price_difference} // 'same_price_only';
% my $approval = $policy->{approval} // 'none';

% if (my @errors = @{ stash('errors') // [] }) {
<div class="alert alert-error" role="alert">
  <ul>
  % for my $error (@errors) {
    <li><%= ref $error ? $error->{message} : $error %></li>
  % }
  </ul>
</div>
% }

<form method="POST" action="<%= $action %>">
  <fieldset>
    <legend>Change policy</legend>
    <div>
      <input type="radio" id="change-none" name="change" value="none" required<%= $chosen eq 'none' ? ' checked' : '' %>>
      <label for="change-none">None: a booking cannot move</label>
    </div>
    <div>
      <input type="radio" id="change-window" name="change" value="window" required<%= $chosen eq 'window' ? ' checked' : '' %>>
      <label for="change-window">Window: a booking may move until a set time before its own</label>
    </div>
  </fieldset>

  <p>A window needs an offer bound to an occurrence or covering a class. These apply only to a window.</p>

  <div class="form-group">
    <label class="form-label" for="window_hours">Window, in hours before the occurrence</label>
    <input class="form-input" type="number" id="window_hours" name="window_hours" value="<%= $policy->{window_hours} %>" min="0" step="1">
    <p>For example 48: a change is allowed up to and including 48 hours before.</p>
  </div>

  <div class="form-group">
    <label class="form-label" for="fee_cents">Change fee, in cents</label>
    <input class="form-input" type="number" id="fee_cents" name="fee_cents" value="<%= $policy->{fee_cents} %>" min="0" step="1">
    <p>0 for a free change. Charged as a one-time payment, so the revenue share applies to it.</p>
  </div>

  <fieldset>
    <legend>Where a booking may move</legend>
    % for my $kind ( [ same_offer => 'Another occurrence of this offer' ], [ same_program => 'Any offer in the same program' ],
    %                [ offer_ids => 'One of the offers checked below' ] ) {
    <div>
      <input type="radio" id="targets-<%= $kind->[0] %>" name="targets" value="<%= $kind->[0] %>"<%= $targets eq $kind->[0] ? ' checked' : '' %>>
      <label for="targets-<%= $kind->[0] %>"><%= $kind->[1] %></label>
    </div>
    % }
    % for my $offer ( @{ stash('target_offers') // [] } ) {
    <div>
      <input type="checkbox" id="offer-<%= $offer->{id} %>" name="offer_ids" value="<%= $offer->{id} %>"<%= $listed{ $offer->{id} } ? ' checked' : '' %>>
      <label for="offer-<%= $offer->{id} %>"><%= $offer->{name} %></label>
    </div>
    % }
  </fieldset>

  <fieldset>
    <legend>A move to a different price</legend>
    % for my $kind ( [ same_price_only => 'Not allowed: a booking moves only to the same price' ],
    %                [ charge_only => 'Charge the difference when the new price is higher' ],
    %                [ charge_and_refund => 'Charge the difference when higher, refund it when lower' ] ) {
    <div>
      <input type="radio" id="price_difference-<%= $kind->[0] %>" name="price_difference" value="<%= $kind->[0] %>"<%= $difference eq $kind->[0] ? ' checked' : '' %>>
      <label for="price_difference-<%= $kind->[0] %>"><%= $kind->[1] %></label>
    </div>
    % }
  </fieldset>

  <fieldset>
    <legend>Approval</legend>
    <div>
      <input type="radio" id="approval-none" name="approval" value="none"<%= $approval eq 'none' ? ' checked' : '' %>>
      <label for="approval-none">None: a change within the policy is made at once</label>
    </div>
    <div>
      <input type="radio" id="approval-required" name="approval" value="required"<%= $approval eq 'required' ? ' checked' : '' %>>
      <label for="approval-required">Required: an administrator approves each change before it is made</label>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Continue</button>
  </div>
</form>
