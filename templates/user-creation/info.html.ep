% extends 'layouts/workflow';
% title 'User Information';

<article class="form-container">
    <header class="form-header">
        <h1>Add New User</h1>
        <p>Enter the details for the new user account.</p>
    </header>

    <form action="<%= $action %>" method="post" class="registry-form">
        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" name="username" id="username" placeholder="Enter username" required />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" placeholder="Enter password" required />
        </div>

        %# Without this the form could only ever make parents, whatever the
        %# step behind it accepted -- users.user_type defaults to 'parent'.
        %# Administrator is offered only to an administrator: user-creation is
        %# reachable by staff too, and a staff member who could grant admin
        %# could promote themselves.
        % my $caller = stash('current_user') || {};
        % my $caller_type = $caller->{user_type} || $caller->{role} || '';
        <div class="form-group">
            <label for="user_type">Account type</label>
            <select name="user_type" id="user_type" required>
                <option value="parent">Parent</option>
                <option value="student">Student</option>
                <option value="staff">Staff</option>
                % if ($caller_type eq 'admin') {
                    <option value="admin">Administrator</option>
                % }
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create User</button>
        </div>
    </form>
</article>
