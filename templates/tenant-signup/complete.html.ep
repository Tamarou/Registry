%# ABOUTME: Tenant signup completion page showing success and Stripe Connect CTA.
%# ABOUTME: Prompts new tenants to connect their Stripe account for payment processing.
% extends 'layouts/default';
% title 'Welcome to Registry!';

<article class="success-container">
    <header class="success-header">
        <section class="success-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="#10b981" stroke-width="2" fill="#f0fdf4"/>
                <path d="m9 12 2 2 4-4" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </section>
        <h1>Welcome to Registry!</h1>
        <p class="success-subtitle">Your organization is set up and ready to go. Here's what happens next:</p>
    </header>

    <section class="tenant-info-card">
        <h2>Your Organization Details</h2>
        <div class="info-grid">
            <div class="info-item">
                <label>Organization:</label>
                <span><%= $organization_name || 'Your Organization' %></span>
            </div>
            <div class="info-item">
                <label>Your Registry URL:</label>
                <span><a href="https://<%= $subdomain %>.registry.localhost" target="_blank"><%= $subdomain %>.registry.localhost</a></span>
            </div>
            <div class="info-item">
                <label>Admin Login:</label>
                <span><%= $admin_email %></span>
            </div>
        </div>
    </section>

    <section class="connect-stripe-cta">
        <h2>Connect Your Stripe Account</h2>
        <p>To accept payments from families, connect a Stripe account. Stripe handles all payment processing securely -- you own your account and all payment data.</p>

        <div class="connect-benefits">
            <div class="benefit-item">
                <h4>Accept Payments</h4>
                <p>Credit cards, debit cards, and bank transfers from families</p>
            </div>
            <div class="benefit-item">
                <h4>Direct Deposits</h4>
                <p>Payments go directly to your bank account</p>
            </div>
            <div class="benefit-item">
                <h4>PCI Compliant</h4>
                <p>No sensitive payment data stored on our servers</p>
            </div>
        </div>

        % if (stash('tenant_id')) {
            <a href="<%= url_for('connect_onboard', tenant_id => stash('tenant_id')) %>"
               class="btn btn-primary btn-xl">
                Connect with Stripe
            </a>
        % }
        <p class="connect-note">You can also connect Stripe later from your admin settings.</p>
    </section>

    <section class="onboarding-checklist">
        <h2>Next Steps</h2>
        <div class="checklist">
            <article class="checklist-item">
                <div class="step-number">1</div>
                <div class="step-content">
                    <h3>Connect Stripe</h3>
                    <p>Set up payment processing so families can enroll and pay</p>
                </div>
            </article>

            <article class="checklist-item">
                <div class="step-number">2</div>
                <div class="step-content">
                    <h3>Create Your First Program</h3>
                    <p>Set up an after-school program, summer camp, or educational activity</p>
                </div>
            </article>

            <article class="checklist-item">
                <div class="step-number">3</div>
                <div class="step-content">
                    <h3>Share with Families</h3>
                    <p>Invite families to browse programs and register at your Registry URL</p>
                </div>
            </article>
        </div>
    </section>

    <section class="support-section">
        <h2>Need Help Getting Started?</h2>
        <div class="support-options">
            <article class="support-option">
                <h4>Documentation</h4>
                <p>Comprehensive guides for all Registry features</p>
                <a href="https://docs.tinyartempire.com" target="_blank">View Documentation</a>
            </article>
            <article class="support-option">
                <h4>Live Support</h4>
                <p>Chat with our team during business hours</p>
                <a href="mailto:support@tinyartempire.com">support@tinyartempire.com</a>
            </article>
        </div>
    </section>

    <footer class="success-actions">
        <a href="https://<%= $subdomain %>.registry.localhost/login" class="btn btn-primary btn-large">
            Access Your Registry Dashboard
        </a>
        <p class="login-note">
            Use your email (<%= $admin_email %>) and the password you created during signup
        </p>
    </footer>
</article>
