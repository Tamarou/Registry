%# ABOUTME: platform-offer-acceptance's review screen: the chosen platform offer's terms, accepted for this studio.
%# ABOUTME: Accepting posts action=accept; the step re-reads the offer from the listing and refuses with a message.
% extends 'layouts/workflow';
% title 'Accept the terms';
% stash description => 'Once accepted, these terms apply to every sale this studio takes.';
% my $offer = stash('offer');

% if (my @errors = @{ stash('errors') // [] }) {
<div class="alert alert-error" role="alert">
  <ul>
  % for my $error (@errors) {
    <li><%= ref $error ? $error->{message} : $error %></li>
  % }
  </ul>
</div>
% }

% if ($offer) {
<section class="card">
  <h2><%= $offer->{name} %></h2>
  <dl>
    <dt>Platform share of each sale</dt>
    <dd><%= $offer->{rate} %></dd>
  </dl>
</section>
% }

<form method="POST" action="<%= $action %>">
  <input type="hidden" name="action" value="accept">

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Accept</button>
  </div>
</form>
