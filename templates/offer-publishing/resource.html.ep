% extends 'layouts/workflow';
% title 'What the offer sells';
% stash description => 'Use one of your resources, or create the one this offer sells.';
% my $occurrences = stash('occurrences') // [];

% if (my @errors = @{ stash('errors') // [] }) {
<div class="alert alert-error" role="alert">
  <ul>
  % for my $error (@errors) {
    <li><%= ref $error ? $error->{message} : $error %></li>
  % }
  </ul>
</div>
% }

<form method="POST" action="<%= $action %>">
  <fieldset>
    <legend>Resource</legend>
    <div>
      <input type="radio" id="resource_mode-existing" name="resource_mode" value="existing" required>
      <label for="resource_mode-existing">Use one of my existing resources</label>
    </div>
    <div>
      <input type="radio" id="resource_mode-create" name="resource_mode" value="create" required>
      <label for="resource_mode-create">Create a new resource</label>
    </div>
  </fieldset>

  <fieldset>
    <legend>New resource</legend>
    <div class="form-group">
      <label class="form-label" for="resource_name">Name</label>
      <input type="text" id="resource_name" name="resource_name">
    </div>
    <div>
      <input type="radio" id="resource_kind-finite" name="resource_kind" value="finite">
      <label for="resource_kind-finite">Finite: a number of seats or slots</label>
    </div>
    <div>
      <input type="radio" id="resource_kind-unbounded" name="resource_kind" value="unbounded">
      <label for="resource_kind-unbounded">Unbounded: limited only by policy, such as payment processing</label>
    </div>
    <div class="form-group">
      <label class="form-label" for="capacity">Capacity, for a finite resource</label>
      <input type="number" id="capacity" name="capacity" min="1" step="1">
    </div>
    <div class="form-group">
      <label class="form-label" for="event_id">Occurrence it is, for a finite resource</label>
      <select id="event_id" name="event_id">
        <option value="">None</option>
        % for my $occurrence (@$occurrences) {
        <option value="<%= $occurrence->{id} %>"><%= $occurrence->{label} %></option>
        % }
      </select>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Continue</button>
  </div>
</form>
