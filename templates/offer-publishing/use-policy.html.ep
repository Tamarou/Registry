% extends 'layouts/workflow';
% title 'How it is used';
% stash description => 'Say what counts as using what this offer buys.';

% if (my @errors = @{ stash('errors') // [] }) {
<div class="alert alert-error" role="alert">
  <ul>
  % for my $error (@errors) {
    <li><%= ref $error ? $error->{message} : $error %></li>
  % }
  </ul>
</div>
% }

<form method="POST" action="<%= $action %>">
  <fieldset>
    <legend>Use policy</legend>
    <div>
      <input type="radio" id="use-optional_attendance" name="use" value="optional_attendance" required>
      <label for="use-optional_attendance">Optional attendance: a booking may be marked attended; nothing depends on it</label>
    </div>
    <div>
      <input type="radio" id="use-none" name="use" value="none" required>
      <label for="use-none">None: nothing is tracked as use</label>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Continue</button>
  </div>
</form>
