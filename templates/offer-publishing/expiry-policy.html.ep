%# ABOUTME: offer-publishing's expiry-policy screen: when the offer's entitlement expires.
%# ABOUTME: At the end of the occurrence for an occurrence or class offer; never for anything else.
% extends 'layouts/workflow';
% title 'When it expires';
% stash description => 'Say when what this offer buys stops being usable.';
% my $chosen = ( stash('expiry_policy') // {} )->{expiry} // '';

% if (my @errors = @{ stash('errors') // [] }) {
<div class="alert alert-error" role="alert">
  <ul>
  % for my $error (@errors) {
    <li><%= ref $error ? $error->{message} : $error %></li>
  % }
  </ul>
</div>
% }

<form method="POST" action="<%= $action %>">
  <fieldset>
    <legend>Expiry policy</legend>
    <div>
      <input type="radio" id="expiry-end_of_occurrence" name="expiry" value="end_of_occurrence" required<%= $chosen eq 'end_of_occurrence' ? ' checked' : '' %>>
      <label for="expiry-end_of_occurrence">At the end of the occurrence: for an offer on an occurrence or a class</label>
    </div>
    <div>
      <input type="radio" id="expiry-never" name="expiry" value="never" required<%= $chosen eq 'never' ? ' checked' : '' %>>
      <label for="expiry-never">Never: for an offer with no occurrence</label>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Continue</button>
  </div>
</form>
