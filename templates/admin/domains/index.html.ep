% layout 'default';
% title 'Domain Management';
<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold mb-4">Custom Domain Management</h1>

  % if (stash('error')) {
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= stash('error') %>
    </div>
  % }

  % if (stash('passkey_warning')) {
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-4">
      <strong>Passkey re-registration required:</strong>
      After adding a custom domain, users with passkeys must re-register their passkey
      credentials because the domain (rpId) used during registration will change.
    </div>
  % }

  <div class="mb-6">
    <h2 class="text-xl font-semibold mb-2">Add Custom Domain</h2>
    <p class="text-sm text-gray-600 mb-2">
      <strong>Note:</strong> Users with registered passkeys will need to re-register
      their passkey after a custom domain is added, as the domain changes the passkey origin.
    </p>
    <form method="POST" action="/admin/domains">
      <div class="flex gap-2">
        <input type="text" name="domain" placeholder="yourdomain.com"
               class="border rounded px-3 py-2 flex-1" />
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">
          Add Domain
        </button>
      </div>
    </form>
  </div>

  <div>
    <h2 class="text-xl font-semibold mb-2">Your Domains</h2>
    % if (@{stash('domains') // []}) {
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-gray-100">
            <th class="border px-3 py-2 text-left">Domain</th>
            <th class="border px-3 py-2 text-left">Status</th>
            <th class="border px-3 py-2 text-left">Primary</th>
            <th class="border px-3 py-2 text-left">Actions</th>
          </tr>
        </thead>
        <tbody>
          % for my $domain (@{stash('domains')}) {
            <tr>
              <td class="border px-3 py-2"><%= $domain->domain %></td>
              <td class="border px-3 py-2">
                % if ($domain->status eq 'verified') {
                  <span class="text-green-600">Active</span>
                % } elsif ($domain->status eq 'failed') {
                  <span class="text-red-600">Failed: <%= $domain->verification_error %></span>
                % } else {
                  <span class="text-yellow-600">Waiting for DNS verification</span>
                % }
              </td>
              <td class="border px-3 py-2">
                % if ($domain->is_primary) {
                  <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">Primary</span>
                % }
              </td>
              <td class="border px-3 py-2">
                <form method="POST" action="/admin/domains/<%= $domain->id %>/verify" class="inline">
                  <button type="submit" class="text-blue-600 underline text-sm">Check now</button>
                </form>
                % unless ($domain->is_primary) {
                  <form method="POST" action="/admin/domains/<%= $domain->id %>/primary" class="inline ml-2">
                    <button type="submit" class="text-green-600 underline text-sm">Set primary</button>
                  </form>
                % }
                <form method="POST" action="/admin/domains/<%= $domain->id %>"
                      onsubmit="return confirm('Remove this domain?')" class="inline ml-2">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="text-red-600 underline text-sm">Remove</button>
                </form>
              </td>
            </tr>
          % }
        </tbody>
      </table>
    % } else {
      <p class="text-gray-500">No custom domains configured.</p>
    % }
  </div>
</div>
