%# ABOUTME: Stripe Connect onboarding screen -- the only way a tenant becomes able to take money.
%# ABOUTME: Until this is finished, publishing a priced session is refused and no revenue share is earned.
% layout 'dashboard';
% title 'Payments';
% stash active_nav => 'billing';

% my $tenant = stash('tenant');
% my $state  = stash('status_') // 'not_started';

<div class="container">
    <div class="admin-header">
        <div class="admin-header-content">
            <div class="admin-title-section">
                <h1>Payments</h1>
                <p class="text-secondary mt-1">
                    Connect a Stripe account so families can pay you online.
                </p>
            </div>
        </div>
    </div>

    % if (my $error = stash('error') // flash('error')) {
        <div class="alert alert-error mb-4"><p><%= $error %></p></div>
    % }

    % if ($state eq 'ready') {
        <div class="alert alert-success mb-4">
            <p><strong>You can take payments.</strong>
               Stripe has approved this account, so priced programs can be published
               and families can pay for them.</p>
        </div>
        <p class="text-secondary">
            Payouts, disputes and tax documents live in your own Stripe dashboard &mdash;
            the account is yours, not ours.
        </p>
        <form method="POST" action="<%= url_for 'admin_billing_connect' %>" class="mt-4">
            <button type="submit" class="btn btn-secondary">Update payment details</button>
        </form>
    % } elsif ($state eq 'in_progress') {
        <div class="alert alert-warning mb-4">
            <p><strong>Stripe still needs something from you.</strong>
               Onboarding was started but not finished, so payments are not switched on
               yet and priced programs cannot be published.</p>
        </div>
        <form method="POST" action="<%= url_for 'admin_billing_connect' %>">
            <button type="submit" class="btn btn-primary">Finish setting up payments &rarr;</button>
        </form>
    % } else {
        <p>
            Registry does not hold your money. You connect your own Stripe account,
            families pay into it, and our share is taken as a fee on each payment.
        </p>
        <p class="text-secondary">
            Free programs work without this. A program with a price cannot be published
            until Stripe has approved the account.
        </p>
        <form method="POST" action="<%= url_for 'admin_billing_connect' %>" class="mt-4">
            <button type="submit" class="btn btn-primary">Set up payments &rarr;</button>
        </form>
    % }
</div>
